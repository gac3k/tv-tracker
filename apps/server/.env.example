# HTTP server (bind beyond localhost is an explicit decision)
HOST=127.0.0.1
PORT=3000

# Storage
DATA_DIR=.data

# Logging: fatal|error|warn|info|debug|trace
LOG_LEVEL=info

# Periodic sync of enabled providers; 0 disables the scheduler
SYNC_INTERVAL_MINUTES=60

# BullMQ / job queue
REDIS_URL=redis://127.0.0.1:6379

# History pages fetched per sync (50 items each)
SYNC_PAGES=2

# Session inference
WATCHED_THRESHOLD_PERCENT=85
SESSION_GAP_MINUTES=60
NOW_PLAYING_WINDOW_MINUTES=30

# Optional: use a specific Chromium binary (needed e.g. on NixOS)
# BROWSER_EXECUTABLE_PATH=/run/current-system/sw/bin/chromium

# Artwork + canonical runtimes from TMDB (free key: themoviedb.org/settings/api).
# Without it the grid falls back to generated title cards.
# TMDB_API_KEY=
# Must match the language your providers show titles in — matching is
# exact-title-first, so the wrong language mis-resolves sequels.
TMDB_LANGUAGE=en-US
