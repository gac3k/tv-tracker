# Dashboard image (Next.js). API_URL is the in-cluster address of the server
# image; compose uses http://vod-tracker:3000. Override at build if the server
# service is named differently.
FROM node:22-bookworm-slim AS base
ENV PNPM_HOME=/pnpm
ENV PATH=$PNPM_HOME:$PATH
RUN npm install -g pnpm@11.25.0
WORKDIR /app

FROM base AS deps
COPY pnpm-workspace.yaml pnpm-lock.yaml package.json ./
COPY apps/server/package.json apps/server/package.json
COPY apps/web/package.json apps/web/package.json
COPY apps/extension/package.json apps/extension/package.json
RUN pnpm install --frozen-lockfile --filter @vod/web...

FROM deps AS build
ARG API_URL=http://vod-tracker:3000
ENV API_URL=$API_URL
COPY tokens.css tokens.css
COPY apps/web apps/web
RUN pnpm --filter @vod/web build

FROM node:22-bookworm-slim AS runtime
ENV NODE_ENV=production
ENV HOSTNAME=0.0.0.0
ENV PORT=3001
ENV API_URL=http://vod-tracker:3000
WORKDIR /app
COPY --from=build /app/apps/web/.next/standalone ./
COPY --from=build /app/apps/web/.next/static ./apps/web/.next/static
EXPOSE 3001
CMD ["node", "apps/web/server.js"]
